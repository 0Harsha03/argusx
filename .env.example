# ArgusX Environment Configuration
# Copy this file to .env and fill in your values.

# ── Server ────────────────────────────────────────────────────────────────────
APP_NAME=ArgusX
HOST=0.0.0.0
PORT=8000
DEBUG=false
SECRET_KEY=CHANGE-ME-IN-PRODUCTION-USE-A-32-CHAR-RANDOM-SECRET

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (development — zero setup required):
DATABASE_URL=sqlite+aiosqlite:///./argusx.db

# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://argusx_user:strong_password@localhost:5432/argusx

# ── Redis (optional caching layer) ────────────────────────────────────────────
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# ── Model Artifacts ───────────────────────────────────────────────────────────
MODELS_DIR=app/models/artifacts
BEHAVIORAL_MODEL_PATH=app/models/artifacts/behavioral_model.pkl
ANOMALY_DETECTOR_PATH=app/models/artifacts/anomaly_detector.pkl
VECTORIZER_PATH=app/models/artifacts/vectorizer.pkl

# ── Threat Scoring Thresholds (0–100) ─────────────────────────────────────────
SCORE_BLOCK_THRESHOLD=75.0
SCORE_FLAG_THRESHOLD=50.0
SCORE_SANITIZE_THRESHOLD=30.0

# ── Layer Weights (must sum to 1.0) ───────────────────────────────────────────
WEIGHT_PATTERN=0.30
WEIGHT_SEMANTIC=0.25
WEIGHT_BEHAVIORAL=0.30
WEIGHT_ANOMALY=0.15

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=true

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=*

# ── LLM Provider — Gemini (Phase 3 — Priority 1) ─────────────────────────────
# Provider selection order: Gemini → OpenAI → Mock fallback
# Set GEMINI_API_KEY to activate real Gemini inference (free-tier compatible).
# Leave blank to skip Gemini and fall through to OpenAI or mock mode.
#
# To activate Gemini:
#   1. Obtain a key from https://aistudio.google.com/app/apikey
#   2. Set your key below (never commit this file with a real key).
#   3. Optionally change GEMINI_MODEL (default: gemini-1.5-flash).

GEMINI_API_KEY=                        # AIza... (required for Gemini mode)
GEMINI_MODEL=gemini-2.5-flash          # model name passed to generate_content()

# ── LLM Provider — OpenAI (Phase 2 — Priority 2) ─────────────────────────────
# Used when GEMINI_API_KEY is not set or Gemini initialisation fails.
# Leave OPENAI_API_KEY blank (or remove it) to fall back to mock mode.
#
# To activate real OpenAI generation:
#   1. Set your key below (never commit this file with a real key).
#   2. Optionally tune the model and generation parameters.

OPENAI_API_KEY=                        # sk-... (required for OpenAI mode)
OPENAI_MODEL=gpt-4o-mini               # model name passed to chat completions
OPENAI_MAX_TOKENS=1024                 # max tokens in the generated reply
OPENAI_TEMPERATURE=0.7                 # 0.0 = deterministic, 1.0 = creative
OPENAI_TIMEOUT=30                      # request timeout in seconds
