# ArgusX Environment Configuration
# Copy this file to .env and fill in your values.

# ── Server ────────────────────────────────────────────────────────────────────
APP_NAME=ArgusX
HOST=0.0.0.0
PORT=8000
DEBUG=false
SECRET_KEY=CHANGE-ME-IN-PRODUCTION-USE-A-32-CHAR-RANDOM-SECRET

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (development — zero setup required):
DATABASE_URL=sqlite+aiosqlite:///./argusx.db

# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://argusx_user:strong_password@localhost:5432/argusx

# ── Redis (optional caching layer) ────────────────────────────────────────────
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# ── Model Artifacts ───────────────────────────────────────────────────────────
MODELS_DIR=app/models/artifacts
BEHAVIORAL_MODEL_PATH=app/models/artifacts/behavioral_model.pkl
ANOMALY_DETECTOR_PATH=app/models/artifacts/anomaly_detector.pkl
VECTORIZER_PATH=app/models/artifacts/vectorizer.pkl

# ── Threat Scoring Thresholds (0–100) ─────────────────────────────────────────
SCORE_BLOCK_THRESHOLD=75.0
SCORE_FLAG_THRESHOLD=50.0
SCORE_SANITIZE_THRESHOLD=30.0

# ── Layer Weights (must sum to 1.0) ───────────────────────────────────────────
WEIGHT_PATTERN=0.30
WEIGHT_SEMANTIC=0.25
WEIGHT_BEHAVIORAL=0.30
WEIGHT_ANOMALY=0.15

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=true

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=*
